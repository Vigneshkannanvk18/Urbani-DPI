# =============================================================================
# DPI 2 deployment configuration (NON-SECRET). Copy to deploy/dpi2.env (gitignored) and edit.
#
#   cp deploy/dpi2.env.example deploy/dpi2.env
#   ./deploy-ecs-dpi2.sh                     # DRY-RUN: prints the plan, zero AWS calls
#   APPLY=1 CONFIRM_ACCOUNT=<ACCOUNT_ID> ./deploy-ecs-dpi2.sh
#
# Rules
#   * This file never contains a secret VALUE. Secrets are referenced by Secrets Manager NAME in the
#     "secrets" section; values are generated by the script or put with `aws secretsmanager put-secret-value`.
#   * Values with spaces or JSON are quoted. Bash-compatible: the scripts `source` this file.
#   * "# REQUIRED" = the deploy cannot proceed without a value. "# OPTIONAL" = safe default or feature off.
#   * "CLIENT INPUT" marks what we are still waiting for from Urbani (see docs/DPI2_GO_LIVE_MATRIX.md).
#   * Sections: deploy = used by the scripts only; app = injected into the backend container
#     (must be a real backend setting); secrets = Secrets Manager names for app secret variables.
# =============================================================================

#@section deploy
# ---- Target AWS account (item 14) -------------------------------------------
# OPTIONAL: named CLI profile. Empty = default credential chain (CloudShell, SSO env, instance role).
AWS_PROFILE=urbani
# REQUIRED
AWS_REGION=us-east-1
# REQUIRED. Apply mode also needs CONFIRM_ACCOUNT=<this value> typed on the command line.
ACCOUNT_ID=701179923456

# ---- Parallel service next to DPI 1 (item 14) -------------------------------
# DPI 1 stays untouched: urbaniqa-dpi-svc / urbaniqa-dpi-task / host dpi.urbani.io / priority 400.
# REQUIRED
CLUSTER=urbaniqa-qa-observability-cluster
# REQUIRED
SERVICE_NAME=urbaniqa-dpi2-svc
# REQUIRED
TASK_FAMILY=urbaniqa-dpi2-task
# REQUIRED. Parallel hostname. CLIENT INPUT: final hostname/DNS approval. Cutover to dpi.urbani.io needs CUTOVER=1.
DOMAIN=dpi2.urbani.io
# REQUIRED. Must differ from DPI 1's rule (400).
LISTENER_PRIORITY=401
# REQUIRED
TG_NAME=urbaniqa-dpi2-tg

# ---- Existing network / load balancer (values of the DPI 1 deployment; verify before use) ----
# REQUIRED
VPC_ID=vpc-05ffb7ee97c93b14e
# REQUIRED: two private subnets in two AZs.
SUBNETS=subnet-0136ab68e2ca19b6b,subnet-0e984bc9914fb7096
# REQUIRED: task security group (ALB ingress only).
TASK_SG=sg-0dbf0fb741dd92476
# REQUIRED
ALB_ARN=arn:aws:elasticloadbalancing:us-east-1:701179923456:loadbalancer/app/urbaniqa-qa-alb/7f4704aa0b2a97f1
# REQUIRED
HTTPS_LISTENER_ARN=arn:aws:elasticloadbalancing:us-east-1:701179923456:listener/app/urbaniqa-qa-alb/7f4704aa0b2a97f1/c3325e323fd11bab
# REQUIRED
HTTP_LISTENER_ARN=arn:aws:elasticloadbalancing:us-east-1:701179923456:listener/app/urbaniqa-qa-alb/7f4704aa0b2a97f1/0347c3d7e6d10c6a
# OPTIONAL: only for the Route 53 step (STEPS=dns, needs approval).
HOSTED_ZONE_ID=Z0141203QMOLDPQJCKOF
ALB_DNS=urbaniqa-qa-alb-1567641204.us-east-1.elb.amazonaws.com
ALB_HOSTED_ZONE=Z35SXDOTRQ7X7K

# ---- Images ------------------------------------------------------------------
# REQUIRED. Separate repos from DPI 1 on purpose: pushing ":latest" here cannot change what DPI 1 pulls.
BACKEND_REPO=urbaniqa/dpi2-backend
FRONTEND_REPO=urbaniqa/dpi2-frontend

# ---- Logging ------------------------------------------------------------------
# REQUIRED
LOG_GROUP=/urbani/dpi2
# OPTIONAL
LOG_RETENTION_DAYS=30

# ---- Task size, scaling, deployment (item 14) --------------------------------
# OPTIONAL: Fargate size (DPI 1 uses 512/1024).
TASK_CPU=512
TASK_MEMORY=1024
# OPTIONAL: seconds ECS waits after SIGTERM (backend drains in <= 10 s).
STOP_TIMEOUT_SECONDS=30
# OPTIONAL: desired count at creation, and Application Auto Scaling bounds (min stays >= 2 for two AZs).
DESIRED_COUNT=2
MIN_CAPACITY=2
MAX_CAPACITY=6
# OPTIONAL: target tracking. CPU %, memory %, ALB requests per target per minute.
SCALE_CPU_TARGET=60
SCALE_MEMORY_TARGET=70
SCALE_REQUESTS_PER_TARGET=200
SCALE_IN_COOLDOWN=300
SCALE_OUT_COOLDOWN=60
# OPTIONAL: seconds before the ALB health check can fail a starting task.
HEALTH_CHECK_GRACE_SECONDS=60
# OPTIONAL: 1 = enable ECS Exec on the service (adds ssmmessages permissions). Default off.
ENABLE_EXEC=0
# OPTIONAL: 1 = turn on Container Insights for the SHARED cluster (cluster-wide cost, affects DPI 1 metrics). Default off.
ENABLE_CONTAINER_INSIGHTS=0

# ---- IAM / KMS (item 1, item 14) ----------------------------------------------
# REQUIRED
EXEC_ROLE_NAME=urbaniqa-dpi2-exec-role
# REQUIRED
TASK_ROLE_NAME=urbaniqa-dpi2-task-role
# OPTIONAL: alias of the customer-managed key for the DynamoDB table (created if missing, rotation on).
KMS_KEY_ALIAS=alias/urbaniqa-dpi2
# OPTIONAL: use an existing CMK instead (for example the CDK stack key). Empty = create KMS_KEY_ALIAS.
DYNAMODB_KMS_KEY_ARN=

# ---- Alert e-mail through SNS (item 6) ------------------------------------------
# OPTIONAL: 1 = create the SNS topic and pass its ARN to the backend (still needs NOTIFICATIONS_ENABLED=true below).
ENABLE_SNS=0
SNS_TOPIC_NAME=urbaniqa-dpi2-alerts
# CLIENT INPUT (item 6): comma separated alert e-mail addresses. Each recipient must confirm the SNS subscription e-mail.
ALERT_EMAILS=

#@section secrets
# ---- Secrets Manager NAMES (never values) ---------------------------------------
# GENERATED by the script when missing: JWT secret, MFA encryption key, seed admin password.
# To reuse an existing secret (for example a JWT secret), set its name here.
# REQUIRED
SECRET_NAME_JWT_SECRET=urbaniqa/dpi2/jwt-secret
# REQUIRED (item 5): 32 random bytes, base64.
SECRET_NAME_MFA_ENCRYPTION_KEY=urbaniqa/dpi2/mfa-encryption-key
# REQUIRED (item 14): strong random password for the first Super Admin; closes the DPI 1 default-password carry-over.
SECRET_NAME_SEED_ADMIN_PASSWORD=urbaniqa/dpi2/seed-admin-password
# REQUIRED. CLIENT INPUT: the ROTATED Urbani API key. The script creates an EMPTY secret; put the value with
# `aws secretsmanager put-secret-value --secret-id <name> --secret-string file://key.txt` (docs/DPI2_DEPLOYMENT_RUNBOOK.md).
SECRET_NAME_URBANI_API_KEY=urbaniqa/dpi2/urbani-api-key
# OPTIONAL, shells only (item 6, item 5). Referenced by the task ONLY when named in ENABLED_OPTIONAL_SECRETS.
SECRET_NAME_SLACK_WEBHOOK_URL=urbaniqa/dpi2/slack-webhook-url
SECRET_NAME_TEAMS_WEBHOOK_URL=urbaniqa/dpi2/teams-webhook-url
SECRET_NAME_OIDC_CLIENT_SECRET=urbaniqa/dpi2/oidc-client-secret
# OPTIONAL: comma list of SLACK_WEBHOOK_URL,TEAMS_WEBHOOK_URL,OIDC_CLIENT_SECRET to inject. Only after the secret has a value
# (a task whose secret has no value cannot start).
ENABLED_OPTIONAL_SECRETS=

#@section app
# ---- Platform (fixed by the renderer: NODE_ENV=production, PORT=4000, DB_DRIVER=dynamodb, AWS_REGION, AWS_ACCOUNT_ID) ----

# ---- Item 1: persistence (DynamoDB) --------------------------------------------
# REQUIRED. The renderer forces dynamodb; listed so the intent is explicit.
DB_DRIVER=dynamodb
# REQUIRED. Table name is "<prefix>App". CLIENT INPUT: agree the prefix (default Urbani).
DYNAMODB_TABLE_PREFIX=Urbani

# ---- Core: Urbani QA API, chat, Bedrock labels (DPI 1 behaviour) -----------------
# REQUIRED
INTEGRATION_MODE=live
# REQUIRED. CLIENT INPUT: confirm the API base URL (and that the rotated key is issued for it).
URBANI_API_BASE_URL=https://iq71gvk8oi.execute-api.us-east-1.amazonaws.com/qa
URBANI_SERVICE=main
URBANI_SERVICES=main,payments
URBANI_ENVIRONMENT=qa
URBANI_REFRESH_MINUTES=5
URBANI_LOGS_HISTORY_LIMIT=20
URBANI_ALERTS_HISTORY_LIMIT=5
URBANI_CHAT_MODEL_ID=global.amazon.nova-2-lite-v1:0
URBANI_CHAT_TIMEOUT_MS=30000
BEDROCK_PRIMARY_MODEL_ID=global.amazon.nova-2-lite-v1:0
BEDROCK_FALLBACK_MODEL_ID=global.amazon.nova-2-lite-v1:0
BEDROCK_GUARDRAIL_ID=0z947gmtk58a
BEDROCK_GUARDRAIL_NAME=UrbaniQaObservabilityGuardrail
BEDROCK_GUARDRAIL_VERSION=1
DYNAMODB_ALERTS_TABLE=UrbaniAlerts
LOG_LEVEL=info
JWT_EXPIRES_IN=8h
# OPTIONAL: empty = same-origin only (correct behind the nginx proxy).
CORS_ORIGIN=
# REQUIRED. First Super Admin e-mail. The password comes from SECRET_NAME_SEED_ADMIN_PASSWORD.
SEED_ADMIN_EMAIL=admin@urbani.io
# REQUIRED for deep links in alerts. CLIENT INPUT: final public URL (parallel host now, dpi.urbani.io after cutover).
DASHBOARD_BASE_URL=https://dpi2.urbani.io

# ---- Item 2: RBAC (no setting; permission matrix is DRAFT) ------------------------
# CLIENT INPUT: sign-off of the matrix in packages/shared/src/rbac.ts.

# ---- Item 3: audit log ----------------------------------------------------------
# OPTIONAL. CLIENT INPUT: retention period (365 is a placeholder; 0 = forever) and the sensitive-action list.
AUDIT_RETENTION_DAYS=365
AUDIT_RETENTION_JOB=true

# ---- Item 4: log search ---------------------------------------------------------
# OPTIONAL: default | insights. insights needs log-group read access (CLIENT INPUT: log-group names and access).
LOGS_SOURCE=default
# OPTIONAL: required when LOGS_SOURCE=insights, e.g. main=/aws/ecs/urbaniqa-qa-main/app,payments=/aws/ecs/urbaniqa-qa-payments/app
LOGS_INSIGHTS_LOG_GROUPS=
LOGS_INSIGHTS_TIMEOUT_MS=15000
LOGS_INSIGHTS_MAX_RESULTS=1000
LOGS_REGEX_MAX_LENGTH=200

# ---- Item 5: MFA + SSO ----------------------------------------------------------
# OPTIONAL. CLIENT INPUT: MFA policy, comma separated roles (SUPER_ADMIN,INFRA_ADMIN,QA_OPERATOR,READER_AUDITOR). Empty = optional for all.
MFA_REQUIRED_ROLES=
# OPTIONAL: local | oidc. oidc needs the Cognito pool (CLIENT INPUT: Google Workspace admin, group-to-role map, callback URL).
AUTH_PROVIDER=local
AUTH_LOCAL_ENABLED=true
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=
OIDC_SCOPES="openid email profile"
OIDC_GROUPS_CLAIM=cognito:groups
OIDC_GROUP_ROLE_MAP=
OIDC_ALLOWED_EMAIL_DOMAIN=
OIDC_AUTO_PROVISION=true

# ---- Item 6: automatic alerts ---------------------------------------------------
# OPTIONAL: false until the channels are configured. Recommended first step: NOTIFICATIONS_DRY_RUN=true.
NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_DRY_RUN=false
NOTIFICATIONS_ALLOW_MOCK=false
ALERT_POLL_MINUTES=5
NOTIFICATIONS_MAX_ALERT_AGE_MINUTES=60
NOTIFICATIONS_LOG_RETENTION_DAYS=90
TEAMS_WEBHOOK_FORMAT=adaptive
NOTIFICATIONS_WEBHOOK_HOST_ALLOWLIST=
# ALERT_SNS_TOPIC_ARN is derived from SNS_TOPIC_NAME when ENABLE_SNS=1. Webhook URLs are secrets (see secrets section).

# ---- Items 7-8: chat history, feedback, latency ---------------------------------
# OPTIONAL. CLIENT INPUT: retention period and PII policy (90 days is a placeholder).
CHAT_HISTORY_ENABLED=true
CHAT_RETENTION_DAYS=90

# ---- Item 9: health / uptime panel ----------------------------------------------
# OPTIONAL. CLIENT INPUT: health URLs for QA, Main, Payment. JSON array, single line, single quotes around it.
HEALTH_TARGETS=
HEALTH_PROBES_ENABLED=true
HEALTH_PROBE_INTERVAL_SECONDS=60
HEALTH_RETENTION_DAYS=30
# true only if the targets are internal (RFC 1918) addresses.
HEALTH_ALLOW_PRIVATE_TARGETS=false
HEALTH_MIN_SAMPLES=10
HEALTH_MAX_RESPONSE_BYTES=65536

# ---- Item 10: branding / dark mode ----------------------------------------------
# No server setting. CLIENT INPUT: official logo (SVG/PNG, light and dark) and palette hex codes (frontend assets).

# ---- Item 11: export ------------------------------------------------------------
# OPTIONAL. CLIENT INPUT: size limits and whether very large exports should go through S3.
EXPORT_MAX_ROWS=10000
EXPORT_PDF_MAX_ROWS=2000
EXPORT_RATE_LIMIT_PER_MIN=10
EXPORT_TIMEOUT_MS=60000

# ---- Items 12-13: dashboard personalization, load tests --------------------------
# No server setting for production. CLIENT INPUT: widget scope and SLO thresholds (load/ config).
