# =============================================================================
# Urbani Proactive Observability & AI Troubleshooting Assistant
# Environment configuration template (Task 1.3)
#
# Copy this file to `.env` and fill in local values.
# NEVER commit a real `.env`. NEVER put real AWS keys, model IDs bound to an
# account, tokens, or client-specific secrets in source control.
#
# In Phase 1 every AWS/AI/client value is a PLACEHOLDER. Real values arrive in
# Phase 2 (client + AWS) and Phase 3 (confirmed AI model access).
# =============================================================================

# ---- Application ------------------------------------------------------------
NODE_ENV=development
APP_NAME=urbani-observability
LOG_LEVEL=info               # debug | info | warn | error
PORT=4000

# ---- API / Frontend ---------------------------------------------------------
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# ---- Authentication ---------------------------------------------------------
# Generate a strong random secret for real deployments (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-in-local-env-only
JWT_EXPIRES_IN=8h
# Seed admin (local dev bootstrap ONLY; rotate/remove for real environments).
SEED_ADMIN_EMAIL=admin@urbani.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# ---- Database ---------------------------------------------------------------
# Phase 1 uses local SQLite. The repository layer keeps this swappable for the
# real DynamoDB adapter in Phase 2 without touching business logic.
DB_DRIVER=sqlite             # sqlite (phase 1) | dynamodb (phase 2)
DB_SQLITE_PATH=./data/urbani.sqlite

# ---- Integration mode -------------------------------------------------------
# Controls which adapter implementations are wired in. Keep MOCK until the real
# AWS/AI/client dependencies are confirmed. Do NOT flip to "aws" without creds.
INTEGRATION_MODE=mock        # mock | aws

# ---- AWS (PLACEHOLDERS — do not populate until authorized) ------------------
AWS_REGION=us-east-1
# Prefer IAM roles / SSO / instance profiles over static keys. Leave blank in dev.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- CloudWatch (PLACEHOLDERS) ---------------------------------------------
CLOUDWATCH_LOG_GROUP=/aws/elasticbeanstalk/urbani-app
CLOUDWATCH_MAX_LOG_LINES=100
CLOUDWATCH_QUERY_WINDOW_MINUTES=5

# ---- DynamoDB (PLACEHOLDERS) -----------------------------------------------
DYNAMODB_ALERTS_TABLE=UrbaniAlerts
DYNAMODB_GSI_ANOMALY_TYPE=anomaly_type-index

# ---- Amazon Bedrock (PLACEHOLDERS — confirm with AWS/client team) -----------
# Model IDs are config-driven, never hardcoded in business logic. The proposal
# names Claude 3.5 Sonnet v2 primary and Nova Pro/Lite as fallback, but the
# actual confirmed model must be set here once AWS access is granted.
BEDROCK_PRIMARY_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_FALLBACK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_GUARDRAIL_ID=urbani-dpi-guardrail-v1
BEDROCK_TEMPERATURE=0.0
BEDROCK_MAX_TOKENS=1024
BEDROCK_TOP_P=1.0

# ---- Cost / Budget controls (Epic 10) --------------------------------------
# Historical AI initiatives spiked to $5,000-$6,000. Strict guardrails required.
COST_DAILY_BUDGET_USD=2.50
COST_MONTHLY_BUDGET_USD=100.00
COST_SOFT_ALERT_USD=50.00
COST_HARD_ALERT_USD=100.00

# ---- EventBridge scheduler (documented cadence) -----------------------------
COLLECTOR_SCHEDULE_MINUTES=5
