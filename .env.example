# =============================================================================
# Urbani Proactive Observability & AI Troubleshooting Assistant
# SINGLE environment configuration template (Phase 2).
#
# ONE configuration model for local Docker, staging, and production. There is
# intentionally NO .env.local / .env.development / .env.production split — values
# are injected at deploy time (docker-compose env, CI/CD secrets, task defs, etc).
#
# Copy to `.env` for local Docker. NEVER commit real secrets.
# Application code contains no hardcoded hosts/ports/URLs — everything below is
# overridable and safe defaults are only used for bare-metal local dev.
# =============================================================================

# ---- Application ------------------------------------------------------------
NODE_ENV=production            # development | test | production
APP_NAME=urbani-observability
LOG_LEVEL=info                 # debug | info | warn | error
PORT=4000                      # backend listen port (inside its container)

# ---- URLs (OPTIONAL — no host is hardcoded anywhere in app code) ------------
# The browser reaches the API through the same-origin reverse proxy using the
# RELATIVE path /api, so these are usually left BLANK. Set them only if some
# server-side code must build an absolute URL, and only with your real
# environment host (e.g. https://observability.urbani.example).
API_BASE_URL=
FRONTEND_URL=

# ---- CORS -------------------------------------------------------------------
# Comma-separated allow-list of browser origins. Leave EMPTY when the browser
# reaches the API through the same-origin reverse proxy (recommended). Only set
# explicit origins if the API is exposed on a different domain than the UI,
# e.g. CORS_ORIGIN=https://observability.urbani.example
CORS_ORIGIN=

# ---- Authentication ---------------------------------------------------------
# Generate a strong secret for real deployments: `openssl rand -hex 32`.
JWT_SECRET=change-me-in-local-env-only
JWT_EXPIRES_IN=8h
# Seed admin (bootstrap only; rotate/remove for real environments).
SEED_ADMIN_EMAIL=admin@urbani.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# ---- Database ---------------------------------------------------------------
# DATABASE_URL is the canonical, deploy-injected DB location. For SQLite it is a
# path; in Docker it points at a MOUNTED VOLUME so data persists across restarts.
DB_DRIVER=sqlite               # sqlite (default; DPI 1 behaviour) | dynamodb (DPI 2)
DATABASE_URL=/data/urbani.sqlite
DYNAMODB_TABLE_PREFIX=Urbani   # dynamodb driver: the app table is "<prefix>App" (default UrbaniApp)
DYNAMODB_ENDPOINT=             # dynamodb driver: DynamoDB Local URL (e.g. http://127.0.0.1:8000); EMPTY for AWS

# ---- Integration mode -------------------------------------------------------
# mock = all adapters mocked (default). live = use real integrations where
# configured (e.g. the Urbani logs API), mock for the rest. aws = full AWS (later).
INTEGRATION_MODE=mock          # mock | live | aws

# ---- Real Urbani QA telemetry API (Phase 3) ---------------------------------
# The Urbani QA account (us-east-1, environment: qa) exposes per-service logs,
# alerts, AND a live AI chat endpoint via API Gateway, secured by an x-api-key.
# The key is a SECRET — set it only in your real environment's .env / secret
# manager, never commit it. When these are set and INTEGRATION_MODE=live, logs +
# alerts + chat are LIVE; metrics stay MOCK (QA exposes no metrics endpoint).
#
# Endpoints (per enabled service):
#   GET  {base}/logs/latest?service=<svc>
#   GET  {base}/logs/history?service=<svc>&limit=N
#   GET  {base}/alerts/latest?service=<svc>
#   GET  {base}/alerts/history?service=<svc>&limit=N
#   POST {base}/chat               body {"service":"main|payments","question":"..."}
# Chat IS live: it POSTs to {base}/chat and returns the real Amazon Bedrock
# Nova 2 Lite markdown answer. In live mode there is NO mock answer — a failed
# live chat surfaces an honest 503, never a fabricated answer.
URBANI_API_BASE_URL=           # e.g. https://<id>.execute-api.us-east-1.amazonaws.com/qa
URBANI_API_KEY=                # secret; inject at deploy time
URBANI_SERVICE=main
# Enabled services (logs + alerts per service). auth/support are registered but
# disabled upstream (surfaced disabled, never called).
URBANI_SERVICES=main,payments
URBANI_ENVIRONMENT=qa
URBANI_REFRESH_MINUTES=5
# How many history windows to request from GET /logs/history?limit=N. Latest +
# history are merged + de-duped so content is present even when a window is idle.
URBANI_LOGS_HISTORY_LIMIT=20
URBANI_CHAT_MODEL_ID=global.amazon.nova-2-lite-v1:0   # label surfaced in provenance
URBANI_CHAT_TIMEOUT_MS=30000                            # ~30s abort timeout for POST /chat
URBANI_ALERTS_HISTORY_LIMIT=5                           # GET /alerts/history?limit=N

# ---- AWS (PLACEHOLDERS — do not populate until authorized) ------------------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
# Prefer IAM roles / SSO / task roles over static keys. Leave blank in dev.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- CloudWatch (Urbani QA — ECS log groups) --------------------------------
CLOUDWATCH_REGION=us-east-1
# Main service group. Payments group: /aws/ecs/urbaniqa-qa-payments/app
CLOUDWATCH_LOG_GROUP=/aws/ecs/urbaniqa-qa-main/app
CLOUDWATCH_MAX_LOG_LINES=100
CLOUDWATCH_QUERY_WINDOW_MINUTES=5

# ---- DynamoDB (alerts persistence upstream) ---------------------------------
# UrbaniAlerts is the future collector/writer pipeline's table; app data uses <prefix>App.
DYNAMODB_ALERTS_TABLE=UrbaniAlerts
DYNAMODB_GSI_ANOMALY_TYPE=anomaly_type-index

# ---- Amazon Bedrock (Urbani QA — Nova 2 Lite) -------------------------------
# Model IDs are config-driven, never hardcoded in business logic.
BEDROCK_PRIMARY_MODEL_ID=global.amazon.nova-2-lite-v1:0
BEDROCK_FALLBACK_MODEL_ID=global.amazon.nova-2-lite-v1:0
BEDROCK_GUARDRAIL_ID=0z947gmtk58a
BEDROCK_GUARDRAIL_NAME=UrbaniQaObservabilityGuardrail
BEDROCK_GUARDRAIL_VERSION=1
BEDROCK_TEMPERATURE=0.0
BEDROCK_MAX_TOKENS=1024
BEDROCK_TOP_P=1.0

# ---- Cost / Budget controls -------------------------------------------------
COST_DAILY_BUDGET_USD=2.50
COST_MONTHLY_BUDGET_USD=100.00
COST_SOFT_ALERT_USD=50.00
COST_HARD_ALERT_USD=100.00

# ---- EventBridge scheduler (documented cadence) -----------------------------
COLLECTOR_SCHEDULE_MINUTES=5

# ---- Audit log retention (DPI 2 item 3) ------------------------------------
# Events older than this many days are purged once at startup and then every 24h.
# 365 is a PLACEHOLDER: the retention period is a client decision. 0 = keep forever.
AUDIT_RETENTION_DAYS=365
# Set to false to disable the purge job (e.g. when retention is handled elsewhere).
AUDIT_RETENTION_JOB=true

# ---- Log search (DPI 2 item 4; see docs/LOG_SEARCH.md) -------------------------
# default  = current source (mock, or the Urbani /logs API in live mode): a bounded window, not the full stream.
# insights = full CloudWatch stream via Logs Insights. Needs read access to the log groups (client input pending).
LOGS_SOURCE=default
# service=logGroupName pairs, comma-separated. Required when LOGS_SOURCE=insights, e.g.
# LOGS_INSIGHTS_LOG_GROUPS=main=/aws/ecs/urbaniqa-qa-main/app,payments=/aws/ecs/urbaniqa-qa-payments/app
LOGS_INSIGHTS_LOG_GROUPS=
# Max time to wait for one Insights query (ms) and max lines returned per request.
LOGS_INSIGHTS_TIMEOUT_MS=15000
LOGS_INSIGHTS_MAX_RESULTS=1000
# Max length of a user supplied regex (also bounds validation cost).
LOGS_REGEX_MAX_LENGTH=200

# ---- Persistence drivers (DPI 2) ---------------------------------------------
# DB_DRIVER=sqlite (default) keeps DPI 1 behaviour: one SQLite file at DATABASE_URL.
# DB_DRIVER=dynamodb stores everything in ONE table "<DYNAMODB_TABLE_PREFIX>App" (default UrbaniApp).
#   Design: docs/adr/0001-dynamodb-persistence.md
# AWS: leave DYNAMODB_ENDPOINT empty; credentials come from the default chain (ECS task role,
#   SSO, env). Never put AWS keys in this file for deployed environments.
# Local (no AWS account needed). Each step shows bash, then PowerShell (PS>).
# With DYNAMODB_ENDPOINT set, dummy local credentials are used automatically.
# The CLIs need JWT_SECRET too (any value locally), e.g. in packages/backend/.env.
#   1) Start DynamoDB Local (Docker Hub image), either directly (same command in bash and PS>):
#        docker run -d --rm --name urbani-dynamodb-local -p 127.0.0.1:8000:8000 amazon/dynamodb-local:2.5.2 -jar DynamoDBLocal.jar -sharedDb -inMemory
#      or with compose:
#        JWT_SECRET=dev docker compose --profile dynamodb up -d dynamodb-local
#        PS> $env:JWT_SECRET='dev'; docker compose --profile dynamodb up -d dynamodb-local
#      Stop it when done (data is in memory and is lost): docker stop urbani-dynamodb-local
#   2) Create the table (refuses without DYNAMODB_ENDPOINT; add "-- --reset" to recreate it):
#        DYNAMODB_ENDPOINT=http://127.0.0.1:8000 npm run dynamo:tables
#        PS> $env:DYNAMODB_ENDPOINT='http://127.0.0.1:8000'; npm run dynamo:tables
#   3) Seed demo data. Set the endpoint in the same command: without it the seed would target
#      AWS, and it refuses unless --allow-aws is passed.
#        DB_DRIVER=dynamodb DYNAMODB_ENDPOINT=http://127.0.0.1:8000 npm run seed
#        PS> $env:DB_DRIVER='dynamodb'; $env:DYNAMODB_ENDPOINT='http://127.0.0.1:8000'; npm run seed
#   4) Run the API. The startup log "Persistence driver: dynamodb" must show the local endpoint.
#        DB_DRIVER=dynamodb DYNAMODB_ENDPOINT=http://127.0.0.1:8000 npm run dev:backend
#        PS> $env:DB_DRIVER='dynamodb'; $env:DYNAMODB_ENDPOINT='http://127.0.0.1:8000'; npm run dev:backend
# Copy an existing SQLite DB into DynamoDB. --source is required. The run is idempotent and opens
# the source read-only, but run it on a copy, because SQLite may create -wal/-shm files beside it.
# Use an absolute path: this alias resolves a relative path against the repository root, whatever
# folder you run it from. The script prints the path it resolved before it starts.
#        DYNAMODB_ENDPOINT=http://127.0.0.1:8000 npm run dynamo:migrate -- --source /srv/backups/urbani-copy.sqlite --dry-run
#        DYNAMODB_ENDPOINT=http://127.0.0.1:8000 npm run dynamo:migrate -- --source /srv/backups/urbani-copy.sqlite
#        PS> $env:DYNAMODB_ENDPOINT='http://127.0.0.1:8000'; npm run dynamo:migrate -- --source C:\backups\urbani-copy.sqlite --dry-run
#        PS> $env:DYNAMODB_ENDPOINT='http://127.0.0.1:8000'; npm run dynamo:migrate -- --source C:\backups\urbani-copy.sqlite
#      Exit codes: 0 ok; 1 if any item failed or DynamoDB is unreachable; 2 on usage/config/guard errors.
# Contract tests against DynamoDB Local:
#        DYNAMODB_ENDPOINT=http://127.0.0.1:8000 npm test
#        PS> $env:DYNAMODB_ENDPOINT='http://127.0.0.1:8000'; npm test
# PowerShell keeps $env: values for the rest of the session. Clear them with:
#        PS> Remove-Item Env:DB_DRIVER, Env:DYNAMODB_ENDPOINT -ErrorAction SilentlyContinue
# Switching back to sqlite does not copy DynamoDB data back.

# ---------------------------------------------------------------------------------------------
# MFA (TOTP) and SSO (OIDC) - DPI 2 item 5. Full guide: docs/AUTH_MFA_SSO.md
# ---------------------------------------------------------------------------------------------
# Comma-separated RBAC roles that MUST use MFA (SUPER_ADMIN,INFRA_ADMIN,QA_OPERATOR,READER_AUDITOR).
# Empty = MFA optional for everyone. PLACEHOLDER default pending the client's policy decision.
MFA_REQUIRED_ROLES=
# 32 random bytes, base64 (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
# REQUIRED in production before anyone can enrol; keep it in Secrets Manager. Dev/test use a labelled dev key.
MFA_ENCRYPTION_KEY=

# Authentication provider: local (default, unchanged behaviour) | oidc
AUTH_PROVIDER=local
# Keep the password form available next to SSO (break-glass admin). Set false to force SSO only.
AUTH_LOCAL_ENABLED=true
# OIDC (Amazon Cognito federated with Google Workspace). Secrets come from Secrets Manager / env only.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
OIDC_GROUPS_CLAIM=cognito:groups
# JSON: IdP group name -> RBAC role. The highest-privilege mapped role wins; no mapped group = denied.
# OIDC_GROUP_ROLE_MAP={"SuperAdmins":"SUPER_ADMIN","InfraAdmins":"INFRA_ADMIN","QaOperators":"QA_OPERATOR","ReadersAuditors":"READER_AUDITOR"}
OIDC_GROUP_ROLE_MAP=
# Optional: only this e-mail domain may sign in via SSO (e.g. urbani.io)
OIDC_ALLOWED_EMAIL_DOMAIN=
# Create a user record on first SSO login (default true)
OIDC_AUTO_PROVISION=true
# ---- Automatic alert notifications (DPI 2 item 6; see docs/NOTIFICATIONS.md) ----
# Master switch. Off by default. The background poller also needs INTEGRATION_MODE=live.
NOTIFICATIONS_ENABLED=false
# true = nothing is sent; what WOULD be sent is written to the delivery log and the application log.
NOTIFICATIONS_DRY_RUN=false
# true = also notify the seeded MOCK alerts (demos only). Live alerts are always eligible.
NOTIFICATIONS_ALLOW_MOCK=false
# Poll interval for the Urbani QA alerts API (minutes).
ALERT_POLL_MINUTES=5
# Alerts older than this (and older than the moment the engine first ran) are never notified.
NOTIFICATIONS_MAX_ALERT_AGE_MINUTES=60
# Delivery-log retention in days (0 = keep forever).
NOTIFICATIONS_LOG_RETENTION_DAYS=90
# E-mail through Amazon SNS: the topic ARN (subscribers are managed in AWS and must confirm).
ALERT_SNS_TOPIC_ARN=
# Slack incoming webhook / Microsoft Teams webhook. SECRETS: env or Secrets Manager only, never commit real values.
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
# adaptive (Teams Workflows webhook, default) | messagecard (legacy connector)
TEAMS_WEBHOOK_FORMAT=adaptive
# Extra allowed webhook hosts, comma separated (defaults: hooks.slack.com, *.webhook.office.com, *.logic.azure.com, *.environment.api.powerplatform.com)
NOTIFICATIONS_WEBHOOK_HOST_ALLOWLIST=
# Base URL for the "open in dashboard" link (falls back to FRONTEND_URL; no link when both are empty).
DASHBOARD_BASE_URL=
