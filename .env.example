# =============================================================================
# Urbani Proactive Observability & AI Troubleshooting Assistant
# SINGLE environment configuration template (Phase 2).
#
# ONE configuration model for local Docker, staging, and production. There is
# intentionally NO .env.local / .env.development / .env.production split — values
# are injected at deploy time (docker-compose env, CI/CD secrets, task defs, etc).
#
# Copy to `.env` for local Docker. NEVER commit real secrets.
# Application code contains no hardcoded hosts/ports/URLs — everything below is
# overridable and safe defaults are only used for bare-metal local dev.
# =============================================================================

# ---- Application ------------------------------------------------------------
NODE_ENV=production            # development | test | production
APP_NAME=urbani-observability
LOG_LEVEL=info                 # debug | info | warn | error
PORT=4000                      # backend listen port (inside its container)

# ---- URLs (OPTIONAL — no host is hardcoded anywhere in app code) ------------
# The browser reaches the API through the same-origin reverse proxy using the
# RELATIVE path /api, so these are usually left BLANK. Set them only if some
# server-side code must build an absolute URL, and only with your real
# environment host (e.g. https://observability.urbani.example).
API_BASE_URL=
FRONTEND_URL=

# ---- CORS -------------------------------------------------------------------
# Comma-separated allow-list of browser origins. Leave EMPTY when the browser
# reaches the API through the same-origin reverse proxy (recommended). Only set
# explicit origins if the API is exposed on a different domain than the UI,
# e.g. CORS_ORIGIN=https://observability.urbani.example
CORS_ORIGIN=

# ---- Authentication ---------------------------------------------------------
# Generate a strong secret for real deployments: `openssl rand -hex 32`.
JWT_SECRET=change-me-in-local-env-only
JWT_EXPIRES_IN=8h
# Seed admin (bootstrap only; rotate/remove for real environments).
SEED_ADMIN_EMAIL=admin@urbani.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# ---- Database ---------------------------------------------------------------
# DATABASE_URL is the canonical, deploy-injected DB location. For SQLite it is a
# path; in Docker it points at a MOUNTED VOLUME so data persists across restarts.
DB_DRIVER=sqlite               # sqlite (current) | dynamodb (Phase 3)
DATABASE_URL=/data/urbani.sqlite

# ---- Integration mode -------------------------------------------------------
# mock = all adapters mocked (default). live = use real integrations where
# configured (e.g. the Urbani logs API), mock for the rest. aws = full AWS (later).
INTEGRATION_MODE=mock          # mock | live | aws

# ---- Real Urbani QA telemetry API (Phase 3) ---------------------------------
# The Urbani QA account (us-east-1, environment: qa) exposes per-service logs,
# alerts, AND a live AI chat endpoint via API Gateway, secured by an x-api-key.
# The key is a SECRET — set it only in your real environment's .env / secret
# manager, never commit it. When these are set and INTEGRATION_MODE=live, logs +
# alerts + chat are LIVE; metrics stay MOCK (QA exposes no metrics endpoint).
#
# Endpoints (per enabled service):
#   GET  {base}/logs/latest?service=<svc>
#   GET  {base}/logs/history?service=<svc>&limit=N
#   GET  {base}/alerts/latest?service=<svc>
#   GET  {base}/alerts/history?service=<svc>&limit=N
#   POST {base}/chat               body {"service":"main|payments","question":"..."}
# Chat IS live: it POSTs to {base}/chat and returns the real Amazon Bedrock
# Nova 2 Lite markdown answer. In live mode there is NO mock answer — a failed
# live chat surfaces an honest 503, never a fabricated answer.
URBANI_API_BASE_URL=           # e.g. https://<id>.execute-api.us-east-1.amazonaws.com/qa
URBANI_API_KEY=                # secret; inject at deploy time
URBANI_SERVICE=main
# Enabled services (logs + alerts per service). auth/support are registered but
# disabled upstream (surfaced disabled, never called).
URBANI_SERVICES=main,payments
URBANI_ENVIRONMENT=qa
URBANI_REFRESH_MINUTES=5
# How many history windows to request from GET /logs/history?limit=N. Latest +
# history are merged + de-duped so content is present even when a window is idle.
URBANI_LOGS_HISTORY_LIMIT=20
URBANI_CHAT_MODEL_ID=global.amazon.nova-2-lite-v1:0   # label surfaced in provenance
URBANI_CHAT_TIMEOUT_MS=30000                            # ~30s abort timeout for POST /chat
URBANI_ALERTS_HISTORY_LIMIT=5                           # GET /alerts/history?limit=N

# ---- AWS (PLACEHOLDERS — do not populate until authorized) ------------------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
# Prefer IAM roles / SSO / task roles over static keys. Leave blank in dev.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- CloudWatch (Urbani QA — ECS log groups) --------------------------------
CLOUDWATCH_REGION=us-east-1
# Main service group. Payments group: /aws/ecs/urbaniqa-qa-payments/app
CLOUDWATCH_LOG_GROUP=/aws/ecs/urbaniqa-qa-main/app
CLOUDWATCH_MAX_LOG_LINES=100
CLOUDWATCH_QUERY_WINDOW_MINUTES=5

# ---- DynamoDB (alerts persistence upstream) ---------------------------------
DYNAMODB_ALERTS_TABLE=UrbaniAlerts
DYNAMODB_GSI_ANOMALY_TYPE=anomaly_type-index

# ---- Amazon Bedrock (Urbani QA — Nova 2 Lite) -------------------------------
# Model IDs are config-driven, never hardcoded in business logic.
BEDROCK_PRIMARY_MODEL_ID=global.amazon.nova-2-lite-v1:0
BEDROCK_FALLBACK_MODEL_ID=global.amazon.nova-2-lite-v1:0
BEDROCK_GUARDRAIL_ID=0z947gmtk58a
BEDROCK_GUARDRAIL_NAME=UrbaniQaObservabilityGuardrail
BEDROCK_GUARDRAIL_VERSION=1
BEDROCK_TEMPERATURE=0.0
BEDROCK_MAX_TOKENS=1024
BEDROCK_TOP_P=1.0

# ---- Cost / Budget controls -------------------------------------------------
COST_DAILY_BUDGET_USD=2.50
COST_MONTHLY_BUDGET_USD=100.00
COST_SOFT_ALERT_USD=50.00
COST_HARD_ALERT_USD=100.00

# ---- EventBridge scheduler (documented cadence) -----------------------------
COLLECTOR_SCHEDULE_MINUTES=5
